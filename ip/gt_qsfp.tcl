# The QSFP28 transceivers: GTY X0Y4..X0Y7 at 25.78125 Gb/s, raw 80-bit data (the GT wizard settings of the CMAC in
# rfsoc4x2_100g_udp, proven on this board), QPLL0 fractional-N from the board's 156.25 MHz QSFP28 reference clock (MGTREFCLK0
# of quad 128, pins AA33 / AA34, routed north: FRACN 8388608 / 2^24 = 0.5, 25.78125 = 156.25 x 165; the IBERT IP offers only
# integer multiples). The transceivers' own PRBS generators and checkers (ports); the In-System IBERT core (ip/isi_qsfp.tcl, eye scans
# in the Vivado hardware manager).
create_ip -vlnv xilinx.com:ip:gtwizard_ultrascale:1.7 -module_name gt_qsfp
set_property -dict [list \
    CONFIG.PRESET {GTY-CAUI_4} \
    CONFIG.INTERNAL_PRESET {CAUI_4} \
    CONFIG.GT_TYPE {GTY} \
    CONFIG.GT_DIRECTION {BOTH} \
    CONFIG.GT_REV {0} \
    CONFIG.CHANNEL_ENABLE {X0Y4 X0Y5 X0Y6 X0Y7} \
    CONFIG.TX_MASTER_CHANNEL {X0Y4} \
    CONFIG.RX_MASTER_CHANNEL {X0Y4} \
    CONFIG.LOCATE_COMMON {CORE} \
    CONFIG.RX_PPM_OFFSET {200} \
    CONFIG.OOB_ENABLE {false} \
    CONFIG.RX_SSC_PPM {0} \
    CONFIG.INS_LOSS_NYQ {12} \
    CONFIG.TX_LINE_RATE {25.78125} \
    CONFIG.TX_PLL_TYPE {QPLL0} \
    CONFIG.TX_REFCLK_FREQUENCY {156.25} \
    CONFIG.TX_DATA_ENCODING {RAW} \
    CONFIG.TX_USER_DATA_WIDTH {80} \
    CONFIG.TX_INT_DATA_WIDTH {80} \
    CONFIG.TX_BUFFER_MODE {1} \
    CONFIG.TX_QPLL_FRACN_NUMERATOR {8388608} \
    CONFIG.TX_OUTCLK_SOURCE {TXPROGDIVCLK} \
    CONFIG.TX_DIFF_SWING_EMPH_MODE {CUSTOM} \
    CONFIG.RX_LINE_RATE {25.78125} \
    CONFIG.RX_PLL_TYPE {QPLL0} \
    CONFIG.RX_REFCLK_FREQUENCY {156.25} \
    CONFIG.RX_DATA_DECODING {RAW} \
    CONFIG.RX_USER_DATA_WIDTH {80} \
    CONFIG.RX_INT_DATA_WIDTH {80} \
    CONFIG.RX_BUFFER_MODE {1} \
    CONFIG.RX_QPLL_FRACN_NUMERATOR {8388608} \
    CONFIG.RX_EQ_MODE {AUTO} \
    CONFIG.RX_JTOL_FC {10} \
    CONFIG.RX_JTOL_LF_SLOPE {-20} \
    CONFIG.RX_OUTCLK_SOURCE {RXOUTCLKPMA} \
    CONFIG.SIM_CPLL_CAL_BYPASS {1} \
    CONFIG.RX_TERMINATION {PROGRAMMABLE} \
    CONFIG.RX_TERMINATION_PROG_VALUE {800} \
    CONFIG.RX_COUPLING {AC} \
    CONFIG.RX_BUFFER_BYPASS_MODE {MULTI} \
    CONFIG.RX_BUFFER_RESET_ON_CB_CHANGE {ENABLE} \
    CONFIG.RX_BUFFER_RESET_ON_COMMAALIGN {DISABLE} \
    CONFIG.RX_BUFFER_RESET_ON_RATE_CHANGE {ENABLE} \
    CONFIG.TX_BUFFER_RESET_ON_RATE_CHANGE {ENABLE} \
    CONFIG.RESET_SEQUENCE_INTERVAL {0} \
    CONFIG.RX_COMMA_PRESET {NONE} \
    CONFIG.RX_COMMA_VALID_ONLY {0} \
    CONFIG.RX_COMMA_P_ENABLE {false} \
    CONFIG.RX_COMMA_M_ENABLE {false} \
    CONFIG.RX_COMMA_DOUBLE_ENABLE {false} \
    CONFIG.RX_COMMA_P_VAL {0101111100} \
    CONFIG.RX_COMMA_M_VAL {1010000011} \
    CONFIG.RX_COMMA_MASK {0000000000} \
    CONFIG.RX_COMMA_ALIGN_WORD {1} \
    CONFIG.RX_COMMA_SHOW_REALIGN_ENABLE {true} \
    CONFIG.RX_SLIDE_MODE {OFF} \
    CONFIG.ENABLE_OPTIONAL_PORTS {loopback_in rxprbscntreset_in rxprbssel_in txprbsforceerr_in txprbssel_in rxprbserr_out rxprbslocked_out gtpowergood_out} \
    CONFIG.RX_REFCLK_SOURCE {X0Y4 clk0 X0Y5 clk0 X0Y6 clk0 X0Y7 clk0} \
    CONFIG.TX_REFCLK_SOURCE {X0Y4 clk0 X0Y5 clk0 X0Y6 clk0 X0Y7 clk0} \
    CONFIG.LOCATE_RESET_CONTROLLER {CORE} \
    CONFIG.LOCATE_TX_BUFFER_BYPASS_CONTROLLER {CORE} \
    CONFIG.LOCATE_RX_BUFFER_BYPASS_CONTROLLER {CORE} \
    CONFIG.LOCATE_IN_SYSTEM_IBERT_CORE {EXAMPLE_DESIGN} \
    CONFIG.LOCATE_TX_USER_CLOCKING {CORE} \
    CONFIG.LOCATE_RX_USER_CLOCKING {CORE} \
    CONFIG.LOCATE_USER_DATA_WIDTH_SIZING {EXAMPLE_DESIGN} \
    CONFIG.ORGANIZE_PORTS_BY {NAME} \
    CONFIG.SECONDARY_QPLL_ENABLE {false} \
    CONFIG.SECONDARY_QPLL_LINE_RATE {10.3125} \
    CONFIG.SECONDARY_QPLL_FRACN_NUMERATOR {0} \
    CONFIG.SECONDARY_QPLL_REFCLK_FREQUENCY {257.8125} \
    CONFIG.TXPROGDIV_FREQ_ENABLE {false} \
    CONFIG.TXPROGDIV_FREQ_SOURCE {QPLL0} \
    CONFIG.TXPROGDIV_FREQ_VAL {322.265625} \
    CONFIG.FREERUN_FREQUENCY {100} \
    CONFIG.INCLUDE_CPLL_CAL {2} \
    CONFIG.USER_GTPOWERGOOD_DELAY_EN {1} \
    CONFIG.ENABLE_COMMON_USRCLK {0} \
    CONFIG.USB_ENABLE {false} \
] [get_ips gt_qsfp]
